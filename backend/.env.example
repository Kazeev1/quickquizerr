PORT=3001

# JWT секрет — поменяйте на случайную строку в продакшене
JWT_SECRET=your-very-secret-key-change-this

# OpenAI API ключ
OPENAI_API_KEY=sk-proj-...

# URL фронтенда на Netlify (для CORS)
FRONTEND_URL=https://your-site.netlify.app

# Путь к базе данных (на Railway укажите /data/quickquizerr.db)
DB_PATH=/data/quickquizerr.db

# Данные администратора
ADMIN_EMAIL=admin@quickquizerr.com
ADMIN_PASSWORD=change-me-in-production
